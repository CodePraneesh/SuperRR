# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

*.csv text eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
Makefile text eol=lf
LICENSE text eol=lf
